{
  "name": "serp-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP: топ-10 мобильной выдачи Google.ca → Google Sheets + LLM-разметка сайтов",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "tsx src/interfaces/cli/index.ts doctor",
    "setup": "tsx src/interfaces/cli/index.ts setup",
    "run": "tsx src/interfaces/cli/index.ts run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/interfaces/cli/index.ts serve",
    "export": "tsx src/interfaces/cli/index.ts export"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@googleapis/sheets": "^18.1.2",
    "@mozilla/readability": "^0.6.0",
    "croner": "^11.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "linkedom": "^0.18.15",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
