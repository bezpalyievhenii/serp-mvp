# Скопируйте в .env и заполните. .env не попадает в git.

# SERP-провайдер: searchapi (по умолчанию) | hasdata (запасной)
SERP_PROVIDER=searchapi
# https://www.searchapi.io → Dashboard → API Key
SEARCHAPI_KEY=
# https://hasdata.com → Dashboard → API Key (необязательно, пока не кончится квота SearchApi)
HASDATA_KEY=

# https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
# ID модели для разметки. Sonnet 5.5 — основной ($2/$10 за 1M), Haiku 5.5 — дешёвый для тестов ($0.10/$0.50).
# Цены — src/adapters/llm/pricing.ts (сверено 2026-11-10)
LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL=claude-haiku-5-5

# ID из адреса таблицы: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=12BkYiaRUA102dNGczqPNrXrNT29PmdLQIKDh_NVG4C8
# Абсолютный путь к JSON-ключу сервисного аккаунта, ВНЕ репозитория (~ не раскрывается)
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/serp-mvp-sa.json
